AIVO_STT_MODEL=models/whisper-small
AIVO_STT_DEVICE=auto
AIVO_STT_COMPUTE=auto
AIVO_OLLAMA_URL=http://127.0.0.1:11434
AIVO_LLM_MODEL=qwen3:4b
AIVO_VOICEVOX_URL=http://127.0.0.1:50021
AIVO_SPEAKER=3
AIVO_VAD_THRESHOLD=0.5
AIVO_SILENCE_MS=800
AIVO_MAX_TOKENS=192
AIVO_CONTEXT=4096
AIVO_KEEP_ALIVE=30m

AIVO_BARGE_THRESHOLD=0.65
AIVO_BARGE_MIN_MS=160

# Search queries / location names are sent to external providers.
AIVO_WEB_SEARCH=true

AIVO_TTS_SPEED=1.0
# Opt-in: save future conversation text to local SQLite only.
AIVO_SAVE_HISTORY=false

# auto: use local browser Japanese speech if VOICEVOX is unavailable.
AIVO_TTS_BACKEND=auto
